#!/usr/bin/make -f

# act's go.mod asks for a newer Go than the suite ships; let the Go tool
# fetch that toolchain, the same trade the builder makes for Rust.
export GOTOOLCHAIN := auto
export GOFLAGS := -trimpath
export GOCACHE := $(CURDIR)/.gocache
export GOPATH := $(CURDIR)/.gopath

%:
	dh $@

override_dh_auto_build:
	go build -buildmode=pie -o act .

# Upstream's test suite runs workflows against a Docker daemon that the
# build container does not have; function is covered by the packaging
# smoke test (a real workflow run) instead.
override_dh_auto_test:

override_dh_auto_install:
	install -Dm0755 act debian/act/usr/bin/act

override_dh_auto_clean:
	rm -rf $(CURDIR)/.gocache $(CURDIR)/.gopath act

# dwz has nothing useful to do on Go binaries.
override_dh_dwz:
