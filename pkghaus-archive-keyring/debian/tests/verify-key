#!/bin/bash
#
# This package ships two keyrings and makes a different promise about each.
#
#   pkghaus-archive-keyring.gpg  the trust anchor apt's Signed-By names. It
#                                carries the primary and the RELEASE-signing
#                                subkey, and nothing else that can sign.
#   pkghaus-source-keyring.gpg   the key that signs .dsc files, for anyone
#                                verifying a source package out of band.
#
# The separation is the point, and the absence assertion below is what enforces
# it. apt trusts EVERY signing-capable key in the file a Signed-By line names,
# so a source-signing key inside the archive keyring could sign a Release that
# every client accepts. That key sits on every build leg of every package,
# which is the exposure the two-subkey split exists to contain, and one shared
# keyring would have handed it straight back. Measured before this was written:
# with both subkeys in one keyring, apt-get update accepts a Release signed by
# either one, and with the split it rejects the source key.
#
# debian/rules asserts the same fingerprints against the files it has just
# dearmored in the build tree. This runs against what dpkg unpacked, so it also
# covers the install path, the files surviving packaging intact, and the
# dearmored form still being a keyring gpg will read.
#
# Fingerprints are written out in full rather than derived. A test that read
# the expected value out of the file it is checking would assert nothing; these
# are the constants from the signing ceremony, and changing one has to be a
# deliberate edit here matching the rotation runbook.

set -euo pipefail

# gpg creates a homedir on first use. Point it at the throwaway directory so
# reading a keyring leaves nothing behind in the testbed's HOME.
export GNUPGHOME="${AUTOPKGTEST_TMP:-$(mktemp -d)}/gnupg"
mkdir -p "$GNUPGHOME"
chmod 700 "$GNUPGHOME"

PRIMARY=79C1BBCBE46FA8B9EBACC93020F923EB99EC1720
RELEASE_SIGNING=DD34C42E776B591FBFEB72A162B67F3EA1FA6DEC
SOURCE_SIGNING=B04D491E3C0209F8C2F7B1F05B88ED4C9FF690E5

ARCHIVE_KEYRING=/usr/share/keyrings/pkghaus-archive-keyring.gpg
SOURCE_KEYRING=/usr/share/keyrings/pkghaus-source-keyring.gpg

# check_keyring <path> <role> <subkey it must carry> <subkey it must not carry>
check_keyring() {
    local keyring="$1" role="$2" wanted="$3" forbidden="$4"
    local colons primary_caps sub_caps caps uid now fpr

    echo "== $role"

    if [ ! -s "$keyring" ]; then
        echo "no keyring at $keyring" >&2
        dpkg -L pkghaus-archive-keyring >&2
        exit 1
    fi

    # A dearmored keyring is binary. An armored one would still parse below but
    # apt's signed-by would not accept it, so the format is worth pinning.
    if head -c 100 "$keyring" | grep -q 'BEGIN PGP PUBLIC KEY BLOCK'; then
        echo "$keyring is ASCII-armored; apt needs the dearmored form" >&2
        exit 1
    fi

    if ! colons="$(gpg --batch --show-keys --with-colons "$keyring" 2>&1)"; then
        echo "gpg could not read $keyring as a keyring" >&2
        printf '%s\n' "$colons" >&2
        exit 1
    fi
    printf '%s\n' "$colons"

    for fpr in "$PRIMARY" "$wanted"; do
        if ! printf '%s\n' "$colons" | grep -q "^fpr:::::::::$fpr:"; then
            echo "$keyring does not carry $fpr" >&2
            exit 1
        fi
    done

    # The security property. Everything else in this function is correctness;
    # this is the line that keeps a leaked source-signing key from being
    # accepted for a Release, and a leaked release key out of source records.
    if printf '%s\n' "$colons" | grep -q "^fpr:::::::::$forbidden:"; then
        echo "$keyring carries $forbidden, which belongs only in the other keyring" >&2
        exit 1
    fi

    # Capability letters are lowercase for what this key itself may do. The
    # primary certifies and must not sign.
    primary_caps="$(printf '%s\n' "$colons" | awk -F: '/^pub:/ { print $12; exit }')"
    case "$primary_caps" in
        *c*) ;;
        *) echo "the primary key cannot certify (capabilities [$primary_caps])" >&2
           exit 1 ;;
    esac

    # Every subkey, not just the first. This once read `/^sub:/ { print $12;
    # exit }`, which was right while there was one subkey and would silently
    # stop checking the moment a rotation put two in a keyring at once.
    #
    # The colons format puts each key's fingerprint on the fpr: line AFTER its
    # sub: line, so the two are paired by walking them in order.
    sub_caps="$(printf '%s\n' "$colons" | awk -F: '
        /^sub:/ { caps = $12; next }
        /^fpr:/ && caps != "" { print $10, caps; caps = "" }')"

    caps="$(printf '%s\n' "$sub_caps" | awk -v f="$wanted" '$1 == f { print $2; exit }')"
    case "$caps" in
        *s*) ;;
        *) echo "subkey $wanted cannot sign (capabilities [$caps])" >&2
           printf '%s\n' "$sub_caps" >&2
           exit 1 ;;
    esac

    uid="$(printf '%s\n' "$colons" | awk -F: '/^uid:/ { print $10; exit }')"
    case "$uid" in
        *"archive@pkg.haus"*) ;;
        *) echo "the keyring's user id is [$uid], not the archive role address" >&2
           exit 1 ;;
    esac

    # An expired key is a broken package: apt rejects every index signed by it.
    # The scheduled watcher warns ahead of time against the published keyring;
    # this catches the case where an already-expired key was packaged at all.
    #
    # One awk over the whole keyring rather than a shell loop. A loop reading
    # from a pipe runs in a subshell, where an exit ends the subshell and not
    # the test; the assertion has to live where its status is the script's.
    now="$(date +%s)"
    if printf '%s\n' "$colons" | awk -F: -v now="$now" \
         '/^(pub|sub):/ && $7 != "" && $7 <= now { bad = 1 } END { exit !bad }'; then
        echo "$keyring contains a key that has already expired" >&2
        printf '%s\n' "$colons" | awk -F: -v now="$now" \
            '/^(pub|sub):/ && $7 != "" && $7 <= now { print "  expired: " $1 " " $5 " at " $7 }' >&2
        exit 1
    fi

    printf '%s\n' "$colons" | awk -F: '/^(pub|sub):/ && $7 != "" { print $1, $5, $7 }' \
        | while read -r kind keyid expires; do
            echo "  $kind $keyid valid until $(date -u -d "@$expires" '+%Y-%m-%d')"
          done

    echo "  ok: $PRIMARY (certify) and $wanted (sign), unexpired, $forbidden absent"
}

check_keyring "$ARCHIVE_KEYRING" \
    "archive keyring, the Signed-By trust anchor" \
    "$RELEASE_SIGNING" "$SOURCE_SIGNING"

check_keyring "$SOURCE_KEYRING" \
    "source keyring, for verifying .dsc signatures" \
    "$SOURCE_SIGNING" "$RELEASE_SIGNING"

echo "both keyrings carry the primary and exactly their own signing subkey"
