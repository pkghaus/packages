#!/bin/sh
# The gate is a real database round-trip, not a rendered frame.
#
# rainfrog has no non-interactive mode, so this drives the TUI through a pty and
# asserts on a table name created HERE, at test time. A binary that draws a
# static layout, or that starts without ever opening the database, cannot
# produce that name.
#
# The pty comes from script(1) and MUST be given a size: its default is 0x0 and
# a TUI with no room renders nothing while still exiting 0.
set -eu

: "${AUTOPKGTEST_TMP:?}"

HOME="$AUTOPKGTEST_TMP/home"
export HOME TERM=xterm-256color
mkdir -p "$HOME"
cd "$AUTOPKGTEST_TMP"

# Distinctive, and generated rather than fixed, so the assertion cannot be
# satisfied by anything the binary already contains.
table="canary_$$_$(date -u +%s)"
db=pkghaus.db
sqlite3 "$db" "CREATE TABLE ${table} (id INTEGER PRIMARY KEY, note TEXT);"
test -s "$db"
echo "--- created table $table in $db"

# Driven by WHAT IS ON SCREEN, not by a fixed sleep. netscanner's sibling test
# passed locally and failed in CI on exactly that: the quit key arrived before
# the first frame and the capture was 365 bytes instead of 8674.
log=render.log
fifo=stdin.fifo
# SIGPIPE ignored around the fifo write below. If the program under test has
# already exited -- which is exactly what a stubbed or broken binary does -- the
# write kills this script with 141 before the explicit failure message can be
# printed, turning a clear "never rendered" verdict into a bare signal.
trap '' PIPE
mkfifo "$fifo"
timeout 120 script -qec "stty rows 40 cols 140; rainfrog --url sqlite://${db}" \
  "$log" < "$fifo" >/dev/null 2>&1 &
sc=$!
# Held open, or rainfrog sees EOF on stdin and exits before connecting.
exec 3> "$fifo"

# Wait for the table, which is the round-trip this test exists to prove.
rendered=no
for _ in $(seq 1 90); do
    if grep -qF "$table" "$log" 2>/dev/null; then rendered=yes; break; fi
    sleep 1
done

printf 'q' >&3 || true
exec 3>&-
wait "$sc" 2>/dev/null || true
rm -f "$fifo"

test -s "$log"
echo "--- captured $(wc -c < "$log") bytes after render=$rendered"
if [ "$rendered" != yes ]; then
    echo "FAIL: $table never appeared in 90s; rainfrog did not query the database" >&2
    exit 1
fi

# Entry and exit from the alternate screen, asserted apart from the content so
# a dead TUI and a changed layout fail differently.
grep -qF '[?1049h' "$log"
echo "--- alternate screen entered"

plain=render.txt
sed -e 's/\x1b\[[0-9;?]*[a-zA-Z]//g' -e 's/\r/\n/g' "$log" > "$plain"

# The round-trip: rainfrog queried sqlite_schema and found what we just made.
grep -qF "$table" "$plain"
echo "--- rainfrog listed $table, so it opened and queried the database"

# And the panes it can only draw once connected. Several, so one renamed label
# does not carry the test alone.
for want in Tables columns indexes constraints; do
    grep -qF "$want" "$plain" || { echo "MISSING from render: $want" >&2; exit 1; }
done
echo "--- schema panes rendered"

echo "PASS: connected to sqlite, read the schema and rendered it"
