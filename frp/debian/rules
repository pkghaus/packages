#!/usr/bin/make -f

# DEB_VERSION_UPSTREAM, for the generated man page.
include /usr/share/dpkg/pkg-info.mk

# frp's go.mod asks for a newer Go than the suite ships; let the Go tool
# fetch that toolchain, the same trade the builder makes for Rust.
export GOTOOLCHAIN := auto
export GOFLAGS := -trimpath
export GOCACHE := $(CURDIR)/.gocache
export GOPATH := $(CURDIR)/.gopath

%:
	dh $@

# The source tag ships no prebuilt web-dashboard assets (upstream builds
# them with Node before its releases); stub them so go:embed resolves.
# The tunneling core is unaffected; the browser dashboards are not part
# of this build.
execute_before_dh_auto_build:
	mkdir -p web/frpc/dist web/frps/dist
	printf 'frp built from source without the web dashboard assets.\n' > web/frpc/dist/index.html
	printf 'frp built from source without the web dashboard assets.\n' > web/frps/dist/index.html

override_dh_auto_build:
	go build -buildmode=pie -o frpc ./cmd/frpc
	go build -buildmode=pie -o frps ./cmd/frps

# Upstream's test suite needs privileged networking; function is covered
# by the packaging smoke test (frpc/frps end-to-end tunnel) instead.
override_dh_auto_test:

override_dh_auto_install:
	install -Dm0755 frpc debian/frp/usr/bin/frpc
	install -Dm0755 frps debian/frp/usr/bin/frps

override_dh_auto_clean:
	rm -rf $(CURDIR)/.gocache $(CURDIR)/.gopath frpc frps

# dwz has nothing useful to do on Go binaries.
override_dh_dwz:

# Upstream ships no man page, so one is generated from the program's own --help
# rather than written here. That invents nothing, and a renamed option changes
# the page in the same build that changes the binary. The synopsis is this
# package's own Description rather than a sentence composed for the occasion.
#
# --locale=C.UTF-8 because help2man's own --locale defaults to C whatever the
# environment says, and under C it rewrites any non-ASCII in the help text
# to "?".
#
# --version-string rather than letting help2man run --version: help2man takes
# the page title from the first token of that output, so a program that greets
# a missing display on the way out gets a page titled XSET:. Pinning it takes
# the title from the executable and the version from the package.
MAN_NAME := $(shell awk '/^Description: /{sub(/^Description: /,""); print; exit}' debian/control)

execute_after_dh_auto_install:
	test -n '$(MAN_NAME)'
	test -n '$(DEB_VERSION_UPSTREAM)'
	install -d debian/frp/usr/share/man/man1
	help2man --no-info --section=1 --locale=C.UTF-8 --name='$(MAN_NAME)' \
		--version-string='$(DEB_VERSION_UPSTREAM)' \
		debian/frp/usr/bin/frpc > debian/frp/usr/share/man/man1/frpc.1
	# A page is not automatically a good one: help2man writes down whatever
	# the program said, and one that cannot run in a build container says so
	# at length. Asserting a real option list rather than a size, because a
	# stack trace is plenty of bytes. Observed range across this fleet is 3
	# to 95 of these; a page built from an error message has none.
	test "$$(grep -cE '^\.(TP|HP|IP|SS)' debian/frp/usr/share/man/man1/frpc.1)" -ge 1
	help2man --no-info --section=1 --locale=C.UTF-8 --name='$(MAN_NAME)' \
		--version-string='$(DEB_VERSION_UPSTREAM)' \
		debian/frp/usr/bin/frps > debian/frp/usr/share/man/man1/frps.1
	# A page is not automatically a good one: help2man writes down whatever
	# the program said, and one that cannot run in a build container says so
	# at length. Asserting a real option list rather than a size, because a
	# stack trace is plenty of bytes. Observed range across this fleet is 3
	# to 95 of these; a page built from an error message has none.
	test "$$(grep -cE '^\.(TP|HP|IP|SS)' debian/frp/usr/share/man/man1/frps.1)" -ge 1
