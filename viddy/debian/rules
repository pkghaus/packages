#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

# Rust's equivalent of Go's -trimpath. Without it the binary embeds the build
# directory and a rebuild anywhere else produces different bytes: every Rust
# package here failed reprotest's build_path variation and every Go one with
# -trimpath passed.
#
# RUSTFLAGS rather than Cargo's own `trim-paths` profile key, which is still
# unstable: cargo 1.98 rejects it outright with "feature `trim-paths` is
# required ... not stabilized in this version of Cargo".
export RUSTFLAGS := --remap-path-prefix=$(CURDIR)=.

# And the registry with it. Cargo unpacks dependency sources under
# CARGO_HOME, whose default is $HOME/.cargo, and rustc embeds those paths:
# 940 of them in one zola binary. Vary $HOME and every one moves, which is
# what reprotest does and why remapping CURDIR alone was not enough.
# In-tree, so the remap above covers it -- the same shape as GOCACHE and
# GOPATH in the Go packages here, which is why no Go binary carries a
# module-cache path.
export CARGO_HOME := $(CURDIR)/.cargo

# rustc is not a Debian package and so is not in .buildinfo's
# Installed-Build-Depends; pinning it here puts the name in debian/rules, which
# ships inside the source package, so a rebuild resolves the same compiler the
# original did. Same reasoning as vale's GOTOOLCHAIN pin. Move it with each
# upstream bump.
#
# Unlike the other Rust packages here, upstream ships a rust-toolchain.toml, and
# it says `channel = "stable"` -- which resolves to whatever stable is on the day
# and is therefore a record rather than a pin. RUSTUP_TOOLCHAIN beats the file
# (rustup reports "environment override by RUSTUP_TOOLCHAIN"), so this is what
# makes the build reproducible past the next Rust release rather than only until
# it. 1.98.0 is the compiler the published -2 was built with.
export RUSTUP_TOOLCHAIN := 1.98.0

# Upstream's build.rs runs vergen, which reads the git tree for a describe
# string and bakes it into `viddy --version` (utils.rs concatenates
# CARGO_PKG_VERSION, VERGEN_GIT_DESCRIBE and VERGEN_BUILD_DATE). The builder
# deletes the clone's .git before building, because a source package cannot
# carry one and anything reading it makes our build differ from a rebuild of
# our own .dsc -- so vergen fell back to its placeholder and shipped
# "1.3.1-VERGEN_IDEMPOTENT_OUTPUT".
#
# vergen checks the environment before computing: add_default_map_entry does
# `env::var(key.name())` and only then falls back (vergen 8.3.2 utils.rs, and
# the gitoxide path does the same). At a release tag `git describe` prints the
# tag, so this is the value upstream's own tagged build produces, and it comes
# from the changelog rather than a git tree -- it ships in the .dsc and cannot
# drift from the packaged version.
export VERGEN_GIT_DESCRIBE := v$(DEB_VERSION_UPSTREAM)

%:
	dh $@

override_dh_auto_clean:
	cargo clean
	rm -rf $(CURDIR)/.cargo

override_dh_auto_build:
	cargo build --release

override_dh_auto_install:
	install -Dm0755 target/release/viddy debian/viddy/usr/bin/viddy
