#!/bin/sh
# netscanner is a full-screen TUI with no non-interactive mode, so the gate is
# rendering one. It has to do real work to pass: the interface name asserted
# below is read from the testbed at run time, so a binary that draws an empty
# frame or prints constants fails.
#
# The pty comes from script(1) and MUST be given a size -- its default is 0x0
# and a TUI with no room renders nothing while still exiting 0.
set -eu

: "${AUTOPKGTEST_TMP:?}"

HOME="$AUTOPKGTEST_TMP/home"
export HOME TERM=xterm-256color
mkdir -p "$HOME"
cd "$AUTOPKGTEST_TMP"

# What the testbed actually has, so the assertion cannot pass on a constant.
iface=""
for d in /sys/class/net/*; do
    n="${d##*/}"
    [ "$n" = lo ] && continue
    iface="$n"; break
done
: "${iface:?no non-loopback interface in the testbed}"
echo "--- expecting netscanner to discover interface: $iface"

# Driven by WHAT IS ON SCREEN, not by a fixed sleep. A `sleep 5; printf q`
# pipeline passed locally at 8674 bytes captured and failed in CI at 365: the
# quit key arrived before the first frame, so the TUI entered and left the
# alternate screen having drawn nothing. A timing-dependent test is worse than
# no test, because CI retries once and a slow runner fails both attempts.
log=render.log
fifo=stdin.fifo
# SIGPIPE ignored around the fifo write below. If the program under test has
# already exited -- which is exactly what a stubbed or broken binary does -- the
# write kills this script with 141 before the explicit failure message can be
# printed, turning a clear "never rendered" verdict into a bare signal.
trap '' PIPE
mkfifo "$fifo"
timeout 90 script -qec "stty rows 40 cols 140; netscanner --tick-rate 4 --frame-rate 8" \
  "$log" < "$fifo" >/dev/null 2>&1 &
sc=$!
# Held open, or netscanner sees EOF on stdin and exits before rendering.
exec 3> "$fifo"

# Wait for the interface to appear, which is the strongest thing this test
# asserts and therefore the right thing to wait for.
rendered=no
for _ in $(seq 1 60); do
    if grep -qF "$iface" "$log" 2>/dev/null; then rendered=yes; break; fi
    sleep 1
done

printf 'q' >&3 || true
exec 3>&-
wait "$sc" 2>/dev/null || true
rm -f "$fifo"

test -s "$log"
echo "--- captured $(wc -c < "$log") bytes after render=$rendered"
if [ "$rendered" != yes ]; then
    echo "FAIL: $iface never appeared in 60s of rendering" >&2
    exit 1
fi

# Entry and exit from the alternate screen, asserted separately from the
# rendered words: a dead TUI and a changed layout then fail differently.
grep -qF '[?1049h' "$log"
grep -qF '[?1049l' "$log"
echo "--- alternate screen entered and left"

plain=render.txt
sed -e 's/\x1b\[[0-9;?]*[a-zA-Z]//g' -e 's/\r/\n/g' "$log" > "$plain"

# The tab strip. Several, so a single renamed tab does not pass the test on its
# own, and a blank screen fails on all of them.
for want in Discovery Interfaces Packets Ports Traffic; do
    grep -qF "$want" "$plain" || { echo "MISSING from render: $want" >&2; exit 1; }
done
echo "--- tab strip rendered"

# The real interface, discovered at run time by netscanner itself.
grep -qF "$iface" "$plain"
echo "--- discovered $iface"

# And the version in the footer, which is the same string debian/rules stamped.
upstream="$(dpkg-query -W -f='${Version}' netscanner)"; upstream="${upstream%%-*}"
grep -qF "$upstream" "$plain"

echo "PASS: rendered the interface, the tab strip and the version"
