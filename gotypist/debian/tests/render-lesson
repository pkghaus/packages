#!/bin/bash
#
# gotypist is a touch-typing tutor. It opens /dev/tty directly and panics if
# there is not one -- even --help fails on a pipe -- so nothing about this
# package can be checked without allocating a terminal. script(1) provides one;
# it lives in bsdutils, which is Essential, so it needs no Depends entry.
#
# The pty script allocates comes up 0x0, and a TUI given no room draws nothing.
# stty inside the child sets a size before gotypist starts. Without it this
# test would still exit 0 while asserting against a blank screen, so the size
# is load-bearing rather than decoration.
#
# -d is upstream's demo mode, meant for capturing screenshots: it draws one
# scripted lesson with no input and exits. That makes it a synchronous test
# rather than a daemon to poll -- measured at ~23ms and byte-identical across
# runs, which is what makes asserting on rendered text safe.
#
# Two kinds of assertion, on purpose. The alternate-screen switch proves the
# terminal was initialised and does not depend on lesson content. The rendered
# words prove text actually reached the screen. If upstream rewrites the demo
# the second set fails while the first still passes, which points at the cause
# instead of at "gotypist is broken".
#
# "battery" is deliberately not asserted although the demo types "correct horse
# battery staple". Demo mode simulates a typo and highlights it, and the colour
# escape lands mid-word, so those letters never appear contiguously in the
# stream. The other three words are unbroken.
#
# There is no version assertion because gotypist has no version flag: -h
# documents only -c, -d, -f and -n. A package that shipped the wrong build
# would not be caught here.

set -euo pipefail

WORK="${AUTOPKGTEST_TMP:-$(mktemp -d)}"
cd "$WORK"

set +e
TERM=xterm-256color timeout 60 script -qec \
    "stty rows 24 cols 80; gotypist -d" /dev/null >"$WORK/screen.out" 2>&1
rc=$?
set -e

if [ "$rc" -ne 0 ]; then
    echo "gotypist -d exited $rc under a pty" >&2
    cat -v "$WORK/screen.out" >&2
    exit 1
fi

if [ ! -s "$WORK/screen.out" ]; then
    echo "gotypist wrote nothing to the terminal" >&2
    exit 1
fi

# Alternate-screen entry and exit. Independent of what the lesson says: the
# first proves the TUI initialised, the second that it tore down rather than
# leaving a terminal in a broken state.
if ! grep -aq '\[?1049h' "$WORK/screen.out"; then
    echo "gotypist never switched to the alternate screen; the TUI did not initialise" >&2
    cat -v "$WORK/screen.out" >&2
    exit 1
fi
if ! grep -aq '\[?1049l' "$WORK/screen.out"; then
    echo "gotypist left the alternate screen without restoring the terminal" >&2
    cat -v "$WORK/screen.out" >&2
    exit 1
fi

for token in 'Score' 'Level' 'correct' 'horse' 'staple'; do
    if ! grep -aq "$token" "$WORK/screen.out"; then
        echo "the rendered screen does not contain [$token]" >&2
        cat -v "$WORK/screen.out" >&2
        exit 1
    fi
done

bytes="$(wc -c <"$WORK/screen.out")"
echo "gotypist rendered a demo lesson into an 80x24 pty ($bytes bytes, score and lesson text present)"
