#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

# Keep the build directory and the in-tree registry out of the binary.
export RUSTFLAGS := --remap-path-prefix=$(CURDIR)=.
export CARGO_HOME := $(CURDIR)/.cargo

# Upstream builds with whatever stable is current and ships no
# rust-toolchain.toml. Floor: edition 2024 (1.85).
export RUSTUP_TOOLCHAIN := 1.98.1

# Debian's OpenSSL and SQLite rather than the copies git2 and rusqlite vendor.
# libgit2 stays vendored: libgit2-sys wants >= 1.9.4 and trixie has 1.9.0.
# Nothing links OpenSSL today (remotes go through the git binary), so only
# SQLite is asserted below.
export OPENSSL_NO_VENDOR := 1
export LIBSQLITE3_SYS_USE_PKG_CONFIG := 1

BIN := target/release/rustman
APP_ID := io.github.animeshchaudhri.rustman

%:
	dh $@

# Upstream's release job seds the tag's version into Cargo.toml, so its binary
# reports X.Y.Z-dev.N where the tree says X.Y.Z. Stamp the same way, and
# stamp Cargo.lock's own entry so --locked still pins every dependency.
execute_before_dh_auto_build:
	[ -f debian/Cargo.toml.upstream ] || cp Cargo.toml debian/Cargo.toml.upstream
	[ -f debian/Cargo.lock.upstream ] || cp Cargo.lock debian/Cargo.lock.upstream
	test -n '$(DEB_VERSION_UPSTREAM)'
	sed -i '0,/^version = /s/^version = ".*"/version = "$(DEB_VERSION_UPSTREAM)"/' Cargo.toml
	sed -i '/^name = "rustman"$$/{n;s/^version = .*/version = "$(DEB_VERSION_UPSTREAM)"/}' Cargo.lock
	grep -qx 'version = "$(DEB_VERSION_UPSTREAM)"' Cargo.toml
	grep -A1 -x 'name = "rustman"' Cargo.lock | grep -qx 'version = "$(DEB_VERSION_UPSTREAM)"'

# --no-default-features is upstream's own distro build: it compiles out the
# in-app updater, so nothing in the binary can replace /usr/bin/rustman.
# Cargo.lock comes patched from debian/patches; --locked fails rather than
# let crates.io decide what a rebuild links.
override_dh_auto_build:
	cargo build --release --locked --no-default-features
	# A -sys crate that misses pkg-config falls back to its bundled copy silently.
	for lib in libsqlite3.so.0 libz.so.1; do \
	    readelf -d $(BIN) | grep -qF "Shared library: [$$lib]" \
	        || { echo "FATAL: $(BIN) does not link $$lib" >&2; exit 1; }; \
	done
	# The updater's GitHub endpoint must be gone with the feature.
	! grep -qaF api.github.com/repos/rust-man-org/rustman $(BIN) \
	    || { echo "FATAL: $(BIN) still contains the self-update endpoint" >&2; exit 1; }

# Upstream's tests are not run here, like every other Rust package in the
# fleet; function is covered by debian/tests.
override_dh_auto_test:

override_dh_auto_install:
	install -Dm0755 $(BIN) debian/rustman/usr/bin/rustman
	install -Dm0644 packaging/linux/$(APP_ID).desktop \
		debian/rustman/usr/share/applications/$(APP_ID).desktop
	install -Dm0644 public/icon.png \
		debian/rustman/usr/share/icons/hicolor/256x256/apps/$(APP_ID).png

override_dh_auto_clean:
	cargo clean
	rm -rf $(CURDIR)/.cargo
	[ ! -f debian/Cargo.toml.upstream ] || mv debian/Cargo.toml.upstream Cargo.toml
	[ ! -f debian/Cargo.lock.upstream ] || mv debian/Cargo.lock.upstream Cargo.lock
