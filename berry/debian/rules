#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

#export DH_VERBOSE=1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

# Upstream's configure defaults --builddir to $TMPDIR/make, so objects compile
# into /tmp/make/berry: outside the source tree, shared between builds, and
# never cleaned if a build is interrupted. Two builds on one machine collide,
# which is how reprotest found it, and a stale object from an earlier build
# would be picked up silently.
# berry's configure takes its version from `git describe` when .git is present
# and otherwise from a hardcoded pkg_verstr, which upstream last updated at
# 0.1.7. The builder deletes the clone's .git before building -- a source
# package cannot carry one -- so every build since fell through to that default
# and shipped a binary reporting 0.1.7 for a 0.1.13 package. A wrong version is
# worse than an absent one: a bug filed against berry 0.1.7 describes code we
# never shipped.
#
# Rewritten rather than passed in, because configure assigns the variable
# outright and an environment value would be overwritten. Asserted both ways so
# upstream renaming the variable, or fixing their default, fails the build here
# instead of silently going back to shipping the wrong number.
override_dh_auto_configure:
	grep -q '^pkg_verstr="[0-9.]*"$$' configure
	sed -i 's/^pkg_verstr="[0-9.]*"$$/pkg_verstr="$(DEB_VERSION_UPSTREAM)"/' configure
	grep -qx 'pkg_verstr="$(DEB_VERSION_UPSTREAM)"' configure
	dh_auto_configure -- --builddir=$(CURDIR)/obj

override_dh_usrlocal:

override_dh_installexamples:
	dh_installexamples "examples/sxhkdrc"
	dh_installexamples "examples/autostart"

override_dh_compress:
	dh_compress -Xexamples

# Upstream ships the sxhkdrc example with an executable bit; it is a
# config file, not a script.
override_dh_fixperms:
	dh_fixperms
	chmod 0644 debian/berry/usr/share/doc/berry/examples/sxhkdrc
